{
  "expo": {
    "name": "KithPaw",
    "slug": "kithpaw",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F9F7F3"
    },
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "KithPaw uses your location to track your dog walk route.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "KithPaw uses your location to track your dog walk route."
      }
    },
    "scheme": "com.ain0315.kithpaw",
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4F7942"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ],
      "edgeToEdgeEnabled": true,
      "package": "com.ain0315.kithpaw"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "KithPaw uses your location to track your dog walk route."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "KithPaw accesses your photos to set a profile picture for your dog."
        }
      ],
      "expo-localization",
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "b3f9e147-9243-437b-86a6-2ef1d7c09149"
      }
    },
    "owner": "ain0315"
  }
}
